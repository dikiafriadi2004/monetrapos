# Environment
NODE_ENV=development
PORT=4404

# Dev flags - set ke false di production
# Jika true, subscription akan auto-aktif saat payment gateway gagal (untuk testing registrasi)
DEV_AUTO_ACTIVATE_SUBSCRIPTION=false
# Add-on TIDAK PERNAH auto-aktif - selalu harus bayar dulu

# Database - MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=monetrapos

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_TTL=300

# JWT
JWT_SECRET=MonetraPOS-dev-secret-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=MonetraPOS-dev-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# API URLs
API_URL=http://151.242.116.114:4404
COMPANY_ADMIN_URL=http://151.242.116.114:4402
MEMBER_ADMIN_URL=http://151.242.116.114:4403

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Xendit Payment Gateway
XENDIT_SECRET_KEY=xnd_development_tgsTJbaewAUOm9igvXdlUACytl2dFrCM0DZ4N6zcXiKdPAZCLAChSqJRTxcRbM
XENDIT_WEBHOOK_TOKEN=sYiQSshlfgwBTKsOn8B79Kshy52tw9DApTCiXubcTOPeINph
XENDIT_IS_PRODUCTION=false

# Email (Optional - bisa dikosongkan untuk testing)
